# Application
APP_NAME=pg-aggregator
APP_ENV=development
APP_PORT=8080
APP_URL=http://localhost:8080

# Frontend
FRONTEND_URL=http://localhost:3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=pg_aggregator
DB_SSLMODE=disable

# Redis (for future use)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# KlikQris Provider
KLIKQRIS_BASE_URL=https://api.klikqris.com
KLIKQRIS_API_KEY=your_klikqris_api_key_here
KLIKQRIS_SECRET_KEY=your_klikqris_secret_key_here
KLIKQRIS_MERCHANT_ID=your_merchant_id_here

# Webhook
WEBHOOK_BASE_URL=http://localhost:8080

# Security
JWT_SECRET=your_jwt_secret_key_change_this_in_production

# Logging
LOG_LEVEL=debug
