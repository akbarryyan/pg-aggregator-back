# HTTPS for the API: Caddy obtains and renews the Let's Encrypt certificate
# automatically (DNS A record api.whuzpay.web.id must point at the VPS and
# ports 80/443 must be open). It replaces any client-sent X-Forwarded-For
# with the real peer address before proxying, which the API trusts via
# [rate_limit] trusted_proxies.
{
	servers {
		protocols h1 h2
	}
}

# Access log shared by every site. By default Caddy records every request
# header, which would write bearer tokens and merchant API keys into the
# container log; the filter below removes them. Do not remove it.
(safe_log) {
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>headers>Authorization delete
				request>headers>X-Api-Key delete
				request>headers>Cookie delete
				request>headers>X-Gateway-Signature delete
				request>headers>Proxy-Authorization delete
				resp_headers>Set-Cookie delete
			}
		}
	}
}

api.whuzpay.web.id {
	encode zstd gzip

	# Same cap as the API itself (middleware.LimitBody, 1 MiB), but rejected at
	# the proxy before the body is forwarded.
	request_body {
		max_size 1MiB
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		# Financial data: nothing from this API may be cached by clients or proxies.
		Cache-Control "no-store"
		-Server
	}

	import safe_log

	reverse_proxy api:8080
}

# Web app. Static assets carry their own cache headers from Next.js, so no
# blanket no-store here (unlike the API). Caddy gets the certificate as soon as
# the DNS A record whuzpay.web.id points at this VPS.
whuzpay.web.id {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}

	import safe_log

	reverse_proxy front:3000
}
