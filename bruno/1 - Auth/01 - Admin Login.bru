meta {
  name: 01 - Admin Login
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/v1/auth/admin/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{admin_email}}",
    "password": "{{admin_password}}"
  }
}

script:post-response {
  if (res.body && res.body.token) {
    bru.setVar("admin_token", res.body.token);
  }
}

tests {
  test("login succeeded", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.body.token).to.be.a("string");
  });
}

docs {
  Run this first. Saves the JWT into {{admin_token}}, which the other
  requests in this collection pick up automatically via Bearer auth.

  Credentials come from the Local environment (seeds/002_admin_user.sql).
}
